{
    "name": "Kali Agent",
    "description": "An AI agent that can perform various tasks and actions based on user input",
    "version": "1.0.0",
    "manifest_version": 3,
    "author": "Kali Team",
    "permissions": ["storage", "sidePanel"],
    "action": {
        "default_title": "Kali Agent",
        "default_icons": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "popup.html"
    }
}